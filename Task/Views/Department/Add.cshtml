@model Department
@{
    ViewData["Title"] = "Add";
}

<h1>Add</h1>
<form method="get" action="/Department/Save">
    <div>
        <label>Add Name</label>
        <input type="text" id="Name" name="Name" value="@Model?.Name" class="form form-control" />
    </div>
    
    <div>
        <label>Add Manger Name</label>
        <input type="text" id="Manger" name="MangerName" value="@Model?.MangerName" class="form form-control" />
    </div>
    <input type="submit" value="Save" class="btn btn-primary" />

</form>
<a href="/Department/ShowAll">Back To List</a>


