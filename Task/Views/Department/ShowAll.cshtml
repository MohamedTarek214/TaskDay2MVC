@model List<Department>

@{
    ViewData["Title"] = "ShowAll";
}

<h1>Show All Departments</h1>
<table class="table table-hover table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            
        </tr>
    }
</table>
<a href="/Department/Add" class="btn btn-danger">Add Department</a>




