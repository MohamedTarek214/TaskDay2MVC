@model Student
@{
    ViewData["Title"] = "ShowDetails";
}

<h1>Student Details</h1>
<table class="table table-hover table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Age</th>
        <th>Department</th>
    </tr>
    <tr>
        <td>@Model.Id</td>
        <td>@Model.Name</td>
        <td>@Model.Age</td>
        <td>@Model.Department.Name</td>
        

    </tr>
    
    }
</table> 

