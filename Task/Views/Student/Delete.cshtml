@using Task.ViewModel
@model StudentVM
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Student</h1>

<h3>Are you sure you want to delete this student?</h3>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Age</th>
        <td>@Model.Age</td>
    </tr>

    <tr>
        <th>Department</th>
        <td>@Model.Name</td>
    </tr>
</table>

<form method="post" action="/Student/DeleteConfirmed">
    <input type="hidden" name="id" value="@Model.Id" />

    <input type="submit" value="Yes, Delete"
           class="btn btn-danger" />

    <a href="/Student/ShowAll" class="btn btn-secondary">
        Cancel
    </a>
</form>
