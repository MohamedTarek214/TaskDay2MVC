@using Task.ViewModel
@model StudentVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Student</h1>

<form method="post" action="/Student/SaveEdit">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label>Name</label>
        <input type="text" name="Name" value="@Model.Name"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Age</label>
        <input type="number" name="Age" value="@Model.Age"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Department</label>

        <select name="DepartmentId" class="form-control">

            @foreach (var item in Model.DeptList)
            {
                if (Model.DepartmentId == item.Id)
                {
                    <option value="@item.Id" selected>
                        @item.Name
                    </option>
                }
                else
                {
                    <option value="@item.Id">
                        @item.Name
                    </option>
                }
            }

        </select>
    </div>

    <input type="submit" value="Save" class="btn btn-success" />

</form>

<a href="/Student/ShowAll">Back To List</a>
